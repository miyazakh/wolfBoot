ARCH?=AARCH64
TARGET?=nxp_imx8
SIGN?=RSA4096
HASH?=SHA3
DEBUG?=1
VTOR?=1
SPMATH?=1
IMAGE_HEADER_SIZE?=1024
PKA?=1
WOLFTPM?=0
DEBUG_UART?=1
NO_XIP?=1
NO_QNX?=1
WOLFBOOT_SECTOR_SIZE=0x400
WOLFBOOT_NO_PARTITIONS=1
# Boot mode
#  NXP_IMX8_BL33=0 (default): started from U-Boot proper
#      fatload mmc 1 0x40480000 wolfboot_linux_pico_v6.bin
#      fatload mmc 1 0x43000000 imx8mm-pico-pi.dtb; go 0x40480000
#    U-Boot has already enabled the MMU and caches; wolfBoot runs with them.
#  NXP_IMX8_BL33=1: started by ATF as BL33 instead of U-Boot proper
#      BootROM -> U-Boot SPL -> ATF (BL31) -> wolfBoot (BL33) -> Linux
#    Entered with MMU and caches off; hal_init() enables the I-cache
#    (-DNXP_IMX8_BL33). DISK_EMMC=1 (default): signed FIT read from eMMC p1;
#    DISK_EMMC=0: signed kernel and DTB are FIT loadables placed by SPL.
NXP_IMX8_BL33?=0
ifeq ($(NXP_IMX8_BL33),1)
  # Link/run address = BL33 address (u-boot.itb "uboot@1", CONFIG_TEXT_BASE)
  WOLFBOOT_LOAD_BASE?=0x40200000
  # Signed kernel placed by SPL; kept clear of the uuu SDP download buffer
  # (0x40400000, the whole FIT is staged there)
  NXP_IMX8_KERNEL_ADDR?=0x48000000
  CFLAGS_EXTRA+=-DNXP_IMX8_BL33
  # MMU off: all memory is Device-nGnRnE, where unaligned accesses fault.
  # Keep the compiler from generating them (as for imx8qm).
  CFLAGS_EXTRA+=-mstrict-align
  # Identity MMU with D-cache for the load/verify (hal_init); do_boot()
  # turns it off again before Linux. NXP_IMX8_MMU=0: I-cache only.
  NXP_IMX8_MMU?=1
  ifeq ($(NXP_IMX8_MMU),1)
    CFLAGS_EXTRA+=-DNXP_IMX8_MMU
  endif
  # eMMC on uSDHC3 through src/sdhci.c (uSDHC->SDHCI shim in the HAL).
  DISK_EMMC?=1
  ifeq ($(DISK_EMMC),1)
    # No card-detect signal on the soldered eMMC
    CFLAGS_EXTRA+=-DSDHCI_FORCE_CARD_DETECT
    # Bring-up: initialize the eMMC and print its MBR in hal_init()
    CFLAGS_EXTRA+=-DNXP_IMX8_EMMC_PROBE
    # eMMC bus: all 8 data lines are routed (DATA0-7 pads in the HAL), High
    # Speed timing at 50 MHz. NXP_IMX8_EMMC_HS=0: the src/sdhci.c default of
    # 4-bit, 25 MHz legacy timing.
    NXP_IMX8_EMMC_HS?=1
    ifeq ($(NXP_IMX8_EMMC_HS),1)
      CFLAGS_EXTRA+=-DSDHCI_EMMC_BUS_WIDTH=8 -DSDHCI_EMMC_HS
    endif
    # Signed FIT (kernel + DTB) read as a file from eMMC p1 (FAT32).
    # Both slots are on partition index 0 (= p1); A/B are two files.
    DISK_FS?=fat32
    CFLAGS_EXTRA+=-DBOOT_PART_A=0 -DBOOT_PART_B=0
    CFLAGS_EXTRA+=-DBOOT_FILE_A='"/fitImage_A.itb"'
    CFLAGS_EXTRA+=-DBOOT_FILE_B='"/fitImage_B.itb"'
    # The whole signed FIT is staged and verified here, then its kernel is
    # copied to the FIT "load" address (0x44000000) and its DTB to
    # WOLFBOOT_LOAD_DTS_ADDRESS. Keep it clear of the kernel (image_size).
    WOLFBOOT_LOAD_ADDRESS?=0x48000000
    WOLFBOOT_RAMBOOT_MAX_SIZE?=0x4000000
    # Read the payload in 64 KB chunks: a chunk of 4 KB or more is one SDMA
    # multi-block read instead of one PIO command per 512-byte sector.
    DISK_BLOCK_SIZE?=65536
    CFLAGS_EXTRA+=-DDISK_BLOCK_SIZE=$(DISK_BLOCK_SIZE)
    # WOLFBOOT_FS_CACHE_SIZE stays at the 512-byte default: a cache of 4 KB or
    # more is read by SDMA, and src/disk_fs.c's fs_cache is not cache-line
    # aligned (it shares a line with sdhci.c's IRQ flags), which corrupts it
    # with the D-cache on (NXP_IMX8_MMU).
  endif
else
  # Link/run address = U-Boot "go" address
  WOLFBOOT_LOAD_BASE?=0x40480000
  # Signed kernel inside wolfboot_linux_pico_v6.bin (offset 0xC0000)
  NXP_IMX8_KERNEL_ADDR?=0x40540000
endif
CFLAGS_EXTRA+=-DNXP_IMX8_KERNEL_ADDR=$(NXP_IMX8_KERNEL_ADDR)
# kernel_addr=0x40540000 in linker; kernel is copied to DDR before boot.
# Must equal kernel_load_addr in nxp_imx8.ld (0x44000000).
WOLFBOOT_LOAD_ADDRESS?=0x44000000
# DTB loaded by U-Boot to 0x43000000 (= dts_addr linker symbol).
# wolfBoot copies DTB from hal_get_dts_address() to this address (same = no-op copy).
WOLFBOOT_LOAD_DTS_ADDRESS?=0x43000000
# EXT_FLASH=1 enables DDR memcpy wrappers in nxp_imx8.c and triggers
# automatic WOLFBOOT_USE_RAMBOOT (kernel is copied to WOLFBOOT_LOAD_ADDRESS).
EXT_FLASH?=1
# Maximum kernel image size for wolfBoot_ramboot() with WOLFBOOT_NO_PARTITIONS=1.
WOLFBOOT_RAMBOOT_MAX_SIZE?=0x2000000
# DEBUG_UART=1: wolfBoot_printf -> uart_printf (src/string.c) -> uart_write()
# in hal/nxp_imx8.c, writing directly to UART2 (0x30890000). No dependency on
# U-Boot (stubs) or glibc. Set DEBUG_UART=0 to disable debug output; then add
# CFLAGS_EXTRA+=-DWOLFBOOT_NO_PRINTF, otherwise v2.7.0+ expands wolfBoot_printf
# to fprintf(stderr) (aarch64-linux-gnu-gcc defines __linux__), which links
# against glibc and jumps to an unresolved PLT entry (address 0).
